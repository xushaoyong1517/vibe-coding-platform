# ── AI ──
MOONSHOT_API_KEY=

# ── 数据库 / 存储：Supabase（部署在阿里云的服务器从这里读写）──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 鉴权 / 定时任务 ──
AUTH_SECRET=
