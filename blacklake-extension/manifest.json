{
  "manifest_version": 3,
  "name": "黑湖小工单 本地同步",
  "version": "2.1.0",
  "description": "拉取黑湖小工单 5 张数据到本地 SQLite(sql.js)；复用网页登录态(不挤掉网页)、定时增量同步、SQL 数据浏览。",
  "permissions": ["storage", "alarms", "webRequest"],
  "host_permissions": ["https://liteweb.blacklake.cn/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "黑湖本地同步" },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
